#!/bin/bash
# Cloud-init for Flo on Ubuntu/Debian. Runs once per droplet.
# Logs land in /var/log/user-data.log for post-mortem.
set -euo pipefail

exec > >(tee -a /var/log/user-data.log) 2>&1

echo "[flo] cloud-init starting at $(date -u +%Y-%m-%dT%H:%M:%SZ)"

apt-get update -y -qq
apt-get install -y -qq curl ca-certificates python3

# Install flo from the release's .deb: the package carries the binary, the
# flo user, /var/lib/flo and the systemd unit, so upgrades are package
# upgrades. A pinned flo_version installs that release; empty, the newest
# one, prereleases included.
%{ if flo_version != "" ~}
FLO_TAG="${flo_version}"
%{ else ~}
FLO_TAG="$(curl -fsSL --retry 5 --retry-connrefused 'https://api.github.com/repos/floruntime/flo/releases?per_page=1' \
  | python3 -c 'import json, sys; print(json.load(sys.stdin)[0]["tag_name"])')"
%{ endif ~}
DEB="flo_$${FLO_TAG#v}_$(dpkg --print-architecture).deb"
WORK="$(mktemp -d)"
curl -fsSL --retry 5 --retry-connrefused -o "$${WORK}/$${DEB}" "https://github.com/floruntime/flo/releases/download/$${FLO_TAG}/$${DEB}"
curl -fsSL --retry 5 --retry-connrefused -o "$${WORK}/$${DEB}.sha256" "https://github.com/floruntime/flo/releases/download/$${FLO_TAG}/$${DEB}.sha256"
(cd "$${WORK}" && sha256sum -c "$${DEB}.sha256")
apt-get install -y -qq "$${WORK}/$${DEB}"
rm -rf "$${WORK}"
echo "[flo] installed $${DEB}"

%{ if volume_enabled ~}
# ---------------------------------------------------------------
# Persistent block-storage volume for /var/lib/flo.
#
# DigitalOcean attaches volumes at boot when volume_ids is set on
# the droplet, but the udev symlink can take a moment to settle —
# wait for it before formatting / mounting.
# ---------------------------------------------------------------
DEVICE="${volume_device_path}"
MOUNT_POINT="/var/lib/flo"
FSTYPE="${volume_filesystem_type}"

echo "[flo] waiting for volume device $${DEVICE}"
for _ in $(seq 1 60); do
  if [ -e "$${DEVICE}" ]; then break; fi
  sleep 1
done
if [ ! -e "$${DEVICE}" ]; then
  echo "[flo] FATAL: volume device $${DEVICE} did not appear within 60s" >&2
  exit 1
fi

# Resolve the symlink to the underlying block device for blkid.
REAL_DEVICE="$(readlink -f "$${DEVICE}")"

# Format only if the volume is blank. Re-attached volumes keep their
# existing filesystem (and data) untouched.
EXISTING_FS="$(blkid -o value -s TYPE "$${REAL_DEVICE}" || true)"
if [ -z "$${EXISTING_FS}" ]; then
  echo "[flo] formatting $${REAL_DEVICE} as $${FSTYPE}"
  case "$${FSTYPE}" in
    ext4) mkfs.ext4 -F -L flo-data "$${REAL_DEVICE}" ;;
    xfs)
      if ! command -v mkfs.xfs >/dev/null 2>&1; then
        apt-get install -y -qq xfsprogs
      fi
      mkfs.xfs -f -L flo-data "$${REAL_DEVICE}"
      ;;
  esac
else
  echo "[flo] reusing existing $${EXISTING_FS} filesystem on $${REAL_DEVICE}"
fi

mkdir -p "$${MOUNT_POINT}"

# Persist via fstab using the stable by-id path so the mount survives
# reboots and survives device-letter reshuffles. nofail keeps the
# droplet bootable even if the volume is missing.
FSTAB_LINE="$${DEVICE} $${MOUNT_POINT} $${FSTYPE} defaults,nofail,discard 0 2"
if ! grep -qsF "$${DEVICE}" /etc/fstab; then
  echo "$${FSTAB_LINE}" >> /etc/fstab
fi

mount -a
echo "[flo] mounted $${DEVICE} at $${MOUNT_POINT}"
%{ endif ~}

# A fresh volume mounted over /var/lib/flo is root's; the service runs as flo.
chown flo:flo /var/lib/flo
chmod 0750 /var/lib/flo

# The module's config replaces the package's loopback-only default. It can
# hold the cluster secret: readable by the service, not by everyone.
cat > /etc/flo/flo.toml <<'FLOTOML'
${flotoml}
FLOTOML
chown root:flo /etc/flo/flo.toml
chmod 640 /etc/flo/flo.toml

mkdir -p /etc/systemd/system/flo.service.d
# Back off from 5 s to 2 min between restarts, until the packaged unit
# carries this itself (systemd 254+; the image is Ubuntu 24.04, systemd 255).
cat > /etc/systemd/system/flo.service.d/backoff.conf <<'UNIT'
[Service]
RestartSteps=5
RestartMaxDelaySec=2min
UNIT
%{ if volume_enabled ~}
# Never start on the root disk's empty /var/lib/flo when the volume is late or
# missing (its fstab entry is nofail): a cluster member would come back with
# an empty log under its old node id.
cat > /etc/systemd/system/flo.service.d/volume.conf <<'UNIT'
[Unit]
RequiresMountsFor=/var/lib/flo
UNIT
%{ endif ~}

systemctl daemon-reload
systemctl enable --now flo

echo "[flo] cloud-init complete; flo managed by systemd"
